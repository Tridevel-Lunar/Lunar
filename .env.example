# Copy to .env.local — optional for local `npm run dev` (without Docker)
# cp .env.example .env.local

# Leave unset to use default /api (Vite dev proxy)
VITE_API_URL=/api

# Google One Tap / Sign in with Google (public OAuth client ID — safe in browser)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
